# =============================================================================
# Bantay Aso — Environment & Synchronization Configuration (Template)
# =============================================================================
# Copy this file to .env and fill in your actual credentials.

# Live Production Node Details
REMOTE_BASE_URL=https://bantayaso.s3curity.net
REMOTE_ADMIN_USER=admin
REMOTE_ADMIN_PASS=your_strong_admin_password_here

# Virtualmin SSH & File Sync Settings
# Confirm your Virtualmin domain user and web root path in:
# Virtualmin > Edit Virtual Server > Server configuration
# Standard Top-Level Domain: /home/<virtualmin_user>/public_html/
# Sub-server Domain:        /home/<parent_user>/domains/bantayaso.s3curity.net/public_html/
VIRTUALMIN_HOST=bantayaso.s3curity.net
VIRTUALMIN_SSH_PORT=22
VIRTUALMIN_USER=your_virtualmin_ssh_user
VIRTUALMIN_REMOTE_PATH=/home/your_virtualmin_user/public_html/

# Path to your private SSH key (e.g., ~/.ssh/id_ed25519)
SSH_KEY_PATH=~/.ssh/id_ed25519

# Local Dev Server Configuration
LOCAL_SERVER_HOST=127.0.0.1
LOCAL_SERVER_PORT=8000

# Feature Toggles (Set to true or false)
ENABLE_SECURITY_HUB=false
ENABLE_SYNC_TOOLS=false

# Autonomous Watchdog Alert Webhook (Discord / Slack / Generic JSON)
# WATCHDOG_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL
