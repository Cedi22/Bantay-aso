# =============================================================================
# Bantay Aso — Git Ignore Rules
# =============================================================================

# Secret Environment Files & Passwords
.env
.env.local
.env.*.local
*.pem
*.key
id_rsa
id_ed25519

# Databases, Journals & WAL files (Keep state separate from code sync)
data/*.sqlite-journal
data/*.sqlite-wal
data/*.sqlite-shm

# Python Caches & Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/

# Node Modules & Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Server Logs & Temporary Files
*.log
error_log
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
